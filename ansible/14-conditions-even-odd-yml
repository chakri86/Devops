- name: even or odd
  hosts: local
  connection: local
  vars:
    number:
      prompt: "please enter a number"
  tasks:
  - name: check number is even or odd
    debug:
      msg: " the given number {{number}} is even"
    when: number % 2 == 0
  - name: check number is odd
    debug:
      msg: " the given number {{number}} is odd"
    when: number % 2 != 0

